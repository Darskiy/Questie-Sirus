# Auto-detect text files and normalize line endings to LF on checkout and commit
* text=auto eol=lf

# Explicitly declare text files
*.lua   text eol=lf
*.toc   text eol=lf
*.xml   text eol=lf
*.py    text eol=lf
*.json  text eol=lf
*.md    text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.txt   text eol=lf

# Denote binary files that should never be modified or normalized
*.png   binary
*.jpg   binary
*.tga   binary
*.blp   binary
*.mp3   binary
*.ogg   binary
*.wav   binary
*.dbc   binary
*.mpq   binary
*.exe   binary

# Exclude development tooling, test suites, and internal scripts from release archives
.*                export-ignore
tools/            export-ignore
tests/            export-ignore
*.test.lua        export-ignore
setupTests.lua    export-ignore
cli/              export-ignore
